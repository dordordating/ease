{
  "manifest_version": 3,
  "name": "Ease",
  "version": "0.4.42",
  "description": "A fast, customizable workspace for everyday browser tasks.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "clipboardWrite",
    "identity",
    "alarms",
    "contextMenus",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": ["https://static.115.164.76.144.clients.your-server.de/*"],
  "optional_permissions": ["notifications", "clipboardRead", "tabs", "tabGroups"],
  "optional_host_permissions": [
    "https://openidconnect.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://graph.microsoft.com/*",
    "https://*.icloud.com/*",
    "https://api.digikala.com/*",
    "https://www.digikala.com/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Ease",
    "default_popup": "workspace.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "workspace.html?surface=panel"
  },
  "omnibox": { "keyword": "ease" },
  "web_accessible_resources": [
    {
      "resources": ["translator-engine.js"],
      "matches": ["https://*/*"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "Open the Ease workspace"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Translate selected text with Ease"
    },
    "quick-task": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Add a task with Ease"
    }
  },
  "oauth2": {
    "client_id": "652222000350-u2ufio5vuk8tnc52e2b9c99ucl780vdi.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}
