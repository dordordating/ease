# Required deployment values. Set these in Coolify or a local .env.
POSTGRES_PASSWORD=
# Use a randomly generated session secret of at least 32 characters.
SESSION_SECRET=
OPENROUTER_API_KEY=

# Comma-separated Google OAuth client IDs.
GOOGLE_CLIENT_IDS=

# Optional until the extension is connected. Use comma-separated exact origins.
CORS_ORIGINS=

# Optional PostgreSQL identity.
# POSTGRES_DB=ease
# POSTGRES_USER=ease

# Optional API overrides. Leave unset to use the application defaults.
# OPENROUTER_MODEL_ECONOMY=
# OPENROUTER_MODEL_STANDARD=
# OPENROUTER_MODEL_PREMIUM=
# USER_DAILY_LIMIT=
# GLOBAL_DAILY_LIMIT=
# SESSION_TTL_MINUTES=
# MAX_TRANSLATION_CHARACTERS=
# MAX_OUTPUT_TOKENS=
# MAX_CONCURRENT_TRANSLATIONS=

# Optional server-side CoinGecko Demo key for market testing.
# COINGECKO_DEMO_API_KEY=
